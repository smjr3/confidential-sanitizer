{
  "name": "confidential-sanitizer",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "predev": "node scripts/copy-wasm.mjs",
    "prebuild": "node scripts/copy-wasm.mjs",
    "postbuild": "node scripts/copy-licenses.mjs",
    "prepack": "npm test && npm run build",
    "package": "node scripts/pack.mjs",
    "test:package": "node --test scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "happy-dom": "20.14.5",
    "typescript": "~5.9.3",
    "vite": "~7.3.1",
    "vitest": "~3.2.4",
    "@huggingface/transformers": "3.8.1"
  },
  "description": "Browser-only confidential information detection and masking app; pretrained models distributed separately.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smjr3/confidential-sanitizer.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "confidential-sanitizer": "bin/confidential-sanitizer.mjs"
  },
  "files": [
    "dist/index.html",
    "dist/favicon.svg",
    "dist/assets/",
    "dist/wasm/",
    "dist/licenses/",
    "bin/",
    "scripts/preview-server.mjs",
    "preview.bat",
    "docs/npm-package.md"
  ]
}
